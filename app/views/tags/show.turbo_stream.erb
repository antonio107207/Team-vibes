<%= turbo_stream.append "feed_entries" do %>
  <% @entries.each do |entry| %>
    <%= render "shared/entry_card", entry: entry %>
  <% end %>
<% end %>

<% if @entries.next_page %>
  <%= turbo_stream.replace "scroll_sentinel_tag" do %>
    <%= render "tags/scroll_sentinel", entries: @entries, tag: @tag %>
  <% end %>
<% else %>
  <%= turbo_stream.remove "scroll_sentinel_tag" %>
<% end %>
