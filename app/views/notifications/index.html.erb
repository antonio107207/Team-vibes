<% content_for :title, t("notifications.title") %>

<div class="space-y-1">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-xl font-bold text-gray-900 dark:text-white"><%= t("notifications.title") %></h1>
  </div>

  <div id="notifications_list" class="divide-y divide-gray-100 dark:divide-gray-700/50 bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 overflow-hidden">
    <% if @notifications.empty? %>
      <div class="py-16 text-center text-gray-400 dark:text-gray-500">
        <svg class="w-10 h-10 mx-auto mb-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
        </svg>
        <p class="text-sm"><%= t("notifications.empty") %></p>
      </div>
    <% else %>
      <% @notifications.each do |notification| %>
        <%= render "notifications/notification", notification: notification %>
      <% end %>
    <% end %>
  </div>

  <%= paginate @notifications %>
</div>
