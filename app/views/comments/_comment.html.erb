<div id="<%= dom_id(comment) %>" class="flex gap-2">
  <img src="<%= comment.user.avatar_or_initials %>" class="w-7 h-7 rounded-full object-cover shrink-0 mt-0.5" alt="">
  <div class="flex-1 bg-gray-50 dark:bg-gray-700 rounded-xl px-3 py-2">
    <div class="flex items-baseline justify-between gap-2">
      <%= link_to comment.user.name, profile_path(comment.user), class: "text-xs font-semibold text-gray-800 dark:text-gray-200 hover:underline" %>
      <span class="text-xs text-gray-400 dark:text-gray-500"><%= time_ago_in_words(comment.created_at) %> <%= t('entry_card.ago') %></span>
    </div>
    <p class="text-sm text-gray-700 dark:text-gray-300 mt-0.5"><%= comment.body %></p>
  </div>
  <% if comment.user == current_user %>
    <%= button_to hobby_entry_comment_path(comment.commentable, comment), method: :delete,
        data: { turbo_stream: true, turbo_confirm: t('comments.delete_confirm') },
        class: "text-gray-300 dark:text-gray-600 hover:text-red-400 dark:hover:text-red-400 text-xs bg-transparent border-0 cursor-pointer self-start mt-1" do %>✕<% end %>
  <% end %>
</div>
