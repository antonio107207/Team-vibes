<%= turbo_stream.append "comments_#{@entry.id}" do %>
  <%= render @comment %>
<% end %>
<%= turbo_stream.replace "new_comment_form" do %>
  <%= form_with model: [@entry, Comment.new], data: { turbo_stream: true }, id: "new_comment_form" do |f| %>
    <div class="flex gap-2">
      <img src="<%= current_user.avatar_or_initials %>" class="w-8 h-8 rounded-full object-cover shrink-0 mt-0.5" alt="">
      <div class="flex-1 flex gap-2">
        <%= f.text_field :body, placeholder: "Напишіть коментар...",
            class: "flex-1 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-transparent",
            autocomplete: "off" %>
        <%= f.submit "→", class: "bg-indigo-600 text-white px-4 rounded-lg hover:bg-indigo-700 transition cursor-pointer text-sm font-bold" %>
      </div>
    </div>
  <% end %>
<% end %>
