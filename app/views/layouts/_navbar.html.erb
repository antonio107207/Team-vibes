<% on_search = request.path == search_path %>
<nav class="bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 sticky top-0 z-10 transition-colors duration-200"
     data-controller="search-toggle"
     data-search-toggle-persistent-value="<%= on_search %>">
  <div class="max-w-2xl mx-auto px-4 h-14 flex items-center justify-between">
    <%= link_to root_path, class: "flex items-center gap-1.5 font-bold text-indigo-600 dark:text-indigo-400 text-base sm:text-lg shrink-0" do %>
      <span>✨</span><span><%= t('nav.app_name') %></span>
    <% end %>

    <div class="flex items-center gap-1 sm:gap-2">
      <%# Locale switcher — hidden on mobile, shown sm+ %>
      <%= button_to locale_path, params: { locale: I18n.locale == :uk ? :en : :uk },
          data: { turbo: false },
          class: "hidden sm:flex px-2 py-1 rounded-lg text-xs font-semibold text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 transition cursor-pointer border border-gray-200 dark:border-gray-600" do %>
        <%= I18n.locale == :uk ? "EN" : "UA" %>
      <% end %>

      <%# Search icon — hidden on search page (bar is always open there) %>
      <% unless on_search %>
        <button type="button"
                data-action="click->search-toggle#toggle"
                class="p-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 transition cursor-pointer"
                title="<%= t('search.title') %>"
                aria-label="<%= t('search.title') %>">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M21 21l-4.35-4.35M17 11A6 6 0 105 11a6 6 0 0012 0z"/>
          </svg>
        </button>
      <% end %>

      <%# Theme toggle — hidden on mobile, shown sm+ %>
      <button data-action="click->theme#toggle"
              class="hidden sm:block p-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 transition cursor-pointer"
              title="<%= t('nav.toggle_theme') %>"
              aria-label="<%= t('nav.toggle_theme') %>">
        <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
        </svg>
        <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </button>

      <% if user_signed_in? %>
        <%# DM icon %>
        <%= link_to conversations_path,
              class: "relative p-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 transition",
              title: t("conversations.title") do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-4 4v-4z"/>
          </svg>
          <span id="dm_count_badge">
            <%= render "conversations/dm_badge", count: current_user.unread_dm_count %>
          </span>
        <% end %>

        <%# Notification bell %>
        <%= link_to notifications_path,
              class: "relative p-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 transition",
              title: t("notifications.title") do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
          </svg>
          <span id="notification_count_badge">
            <%= render "notifications/count", count: current_user.notifications.unread.count %>
          </span>
        <% end %>

        <%# + Add — icon only on mobile, icon + text on sm+ %>
        <%= link_to new_hobby_entry_path,
              class: "flex items-center gap-1 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700 transition px-2 py-1.5 sm:px-3" do %>
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
          </svg>
          <span class="hidden sm:inline text-sm"><%= t('nav.add').sub('+ ', '') %></span>
        <% end %>

        <div class="relative z-20" data-controller="dropdown">
          <button data-action="click->dropdown#toggle" class="flex items-center cursor-pointer">
            <img src="<%= user_avatar_url(current_user) %>" class="w-8 h-8 rounded-full object-cover" alt="<%= current_user.name %>">
          </button>
          <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-52 bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-100 dark:border-gray-700 py-1 text-sm">
            <%= link_to current_user.name, profile_path(current_user), class: "block px-4 py-2 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 font-medium truncate" %>
            <%= link_to t('nav.edit_profile'), edit_profile_path(current_user), class: "block px-4 py-2 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700" %>
            <hr class="my-1 border-gray-100 dark:border-gray-700">
            <%= link_to favorites_path, class: "flex items-center gap-2 px-4 py-2 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 3H7a2 2 0 00-2 2v16l7-3 7 3V5a2 2 0 00-2-2z"/>
              </svg>
              <%= t('nav.favorites') %>
            <% end %>
            <%= link_to following_path, class: "flex items-center gap-2 px-4 py-2 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
              </svg>
              <%= t('nav.following') %>
            <% end %>
            <%= link_to conversations_path, class: "flex items-center gap-2 px-4 py-2 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-4 4v-4z"/>
              </svg>
              <%= t('conversations.title') %>
            <% end %>
            <hr class="my-1 border-gray-100 dark:border-gray-700">
            <%# Theme toggle — mobile only %>
            <button data-action="click->theme#toggle"
                    class="sm:hidden flex items-center gap-2 w-full px-4 py-2 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer">
              <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
              </svg>
              <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
              </svg>
              <%= t('nav.toggle_theme') %>
            </button>
            <%# Locale switcher — mobile only %>
            <%= button_to locale_path, params: { locale: I18n.locale == :uk ? :en : :uk },
                data: { turbo: false },
                class: "sm:hidden flex items-center gap-2 w-full px-4 py-2 text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer text-left" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>
              </svg>
              <%= I18n.locale == :uk ? "English" : "Українська" %>
            <% end %>
            <hr class="my-1 border-gray-100 dark:border-gray-700 sm:hidden">
            <%= button_to t('nav.sign_out'), destroy_user_session_path, method: :delete, class: "w-full text-left px-4 py-2 text-red-600 dark:text-red-400 hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Expandable search bar — persistent on /search, collapsible elsewhere %>
  <div data-search-toggle-target="bar"
       class="<%= on_search ? '' : 'hidden' %> border-t border-gray-100 dark:border-gray-700">
    <div class="max-w-2xl mx-auto px-4 py-2">
      <form action="<%= search_path %>" method="get" class="flex gap-2">
        <%# Preserve active category filter when re-searching %>
        <% if on_search && params[:category].present? %>
          <input type="hidden" name="category" value="<%= params[:category] %>">
        <% end %>
        <div class="relative flex-1">
          <span class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-gray-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M21 21l-4.35-4.35M17 11A6 6 0 105 11a6 6 0 0012 0z"/>
            </svg>
          </span>
          <input type="search"
                 name="q"
                 value="<%= params[:q] %>"
                 data-search-toggle-target="input"
                 data-action="keydown->search-toggle#handleKey input->search-toggle#clearIfEmpty"
                 placeholder="<%= t('search.placeholder') %>"
                 autocomplete="off"
                 class="w-full pl-9 pr-4 py-2 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-sm text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
        </div>
        <button type="submit"
                class="px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-xl hover:bg-indigo-700 transition">
          <%= t("search.submit") %>
        </button>
      </form>
    </div>
  </div>

  <% if user_signed_in? %>
    <div class="max-w-2xl mx-auto relative" data-controller="category-scroll">

      <%# Left arrow %>
      <button type="button"
              data-category-scroll-target="prev"
              data-action="click->category-scroll#scrollPrev"
              class="hidden md:flex absolute left-0 top-0 bottom-2 z-10 items-center pl-2 pr-6
                     bg-gradient-to-r from-white dark:from-gray-800 to-transparent
                     opacity-0 pointer-events-none transition-opacity duration-150 cursor-pointer">
        <svg class="w-4 h-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>

      <%# Scrollable tab track %>
      <div data-category-scroll-target="track"
           class="px-4 pb-2 flex gap-1 overflow-x-auto scrollbar-hide text-sm">
        <% tab_active = ->(active) { active ? 'bg-indigo-100 dark:bg-indigo-900 text-indigo-700 dark:text-indigo-300 font-medium' : 'text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700' } %>
        <% if on_search %>
          <%# On search page: "Всі" removes category filter, categories filter search results %>
          <%= link_to search_path(q: params[:q]),
                class: "shrink-0 px-3 py-1 rounded-full #{tab_active.(params[:category].blank?)}" do %>
            <%= t('nav.all') %>
          <% end %>
        <% else %>
          <% following_active = request.path == root_path && params[:filter] == "following" %>
          <% all_active       = request.path == root_path && params[:filter] != "following" %>
          <%= link_to root_path, class: "shrink-0 px-3 py-1 rounded-full #{tab_active.(all_active)}" do %><%= t('nav.all') %><% end %>
          <%= link_to root_path(filter: "following"), class: "shrink-0 px-3 py-1 rounded-full #{tab_active.(following_active)}" do %><%= t('nav.following_tab') %><% end %>
          <%= link_to trending_path, class: "shrink-0 px-3 py-1 rounded-full #{tab_active.(request.path == trending_path)}" do %>🔥 <%= t('nav.trending') %><% end %>
        <% end %>
        <% HobbyEntry.categories.each_key do |cat| %>
          <% cat_link   = on_search ? search_path(q: params[:q], category: cat) : category_path(cat) %>
          <% cat_active = on_search ? params[:category] == cat : request.path == category_path(cat) %>
          <%= link_to cat_link, class: "shrink-0 px-3 py-1 rounded-full #{tab_active.(cat_active)}" do %>
            <%= HobbyEntry::CATEGORY_ICONS[cat] %> <%= t("categories.#{cat}") %>
          <% end %>
        <% end %>
      </div>

      <%# Right arrow %>
      <button type="button"
              data-category-scroll-target="next"
              data-action="click->category-scroll#scrollNext"
              class="hidden md:flex absolute right-0 top-0 bottom-2 z-10 items-center pr-2 pl-6
                     bg-gradient-to-l from-white dark:from-gray-800 to-transparent
                     opacity-0 pointer-events-none transition-opacity duration-150 cursor-pointer">
        <svg class="w-4 h-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
        </svg>
      </button>

    </div>
  <% end %>
</nav>
